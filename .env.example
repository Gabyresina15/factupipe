MONGODB_URI=mongodb://127.0.0.1:27017/factupipe
PORT=3000

# Motor local QVAC (RTX / GPU). 1 = carga OCR+LLM al arrancar.
QVAC_ENABLED=1
QVAC_CTX_SIZE=2048

# Fallback cloud SOLO si QVAC no está o falló
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

INBOX_DIR=./inbox
PROCESSED_DIR=./processed
FAILED_DIR=./failed
SAMPLES_DIR=./samples
UPLOAD_DIR=./uploads
